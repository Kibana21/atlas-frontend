# Public frontend configuration (copy to .env.local; never put secrets here: NEXT_PUBLIC_* values ship to browsers).
# Atlas API base URL; the local backend often runs on 8100 or 8101 (`make api API_PORT=8100`).
NEXT_PUBLIC_ATLAS_API_BASE_URL=http://127.0.0.1:8100
# Commit SHA of this frontend build (CI/images set it); "unknown" locally.
NEXT_PUBLIC_ATLAS_FRONTEND_SHA=unknown
